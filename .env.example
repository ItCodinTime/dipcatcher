# Copy to .env. Never commit secrets.
QUANT_DATA_ROOT=data
# Optional directory for cached mito0o852/OHLCV-1m monthly Parquet files.
# HF_OHLCV_1M_CACHE=data/hf_ohlcv_1m
MLFLOW_TRACKING_URI=./mlruns
# QUANT_VENDOR_API_KEY=
# Required for non-localhost API access (send as X-API-Key). Prefer binding 127.0.0.1.
# QUANT_API_KEY=

# fx-1 model lane
# Required for `fx1 eval --backend hosted_k3` / `make fx1-eval` (Moonshot API).
# MOONSHOT_API_KEY=
# Enables checkpoint signature enforcement when serving a local fx-1.
# FX1_SIGNING_KEY=

# Audit ledger and observability. Off leaves ingest, features, model,
# decision, and simulated execution on their original code paths.
# DIPCATCHER_OBSERVE=1
# DIPCATCHER_OTEL_ENDPOINT=http://127.0.0.1:4318/v1/traces
# DIPCATCHER_METRICS_PORT=9464
# DIPCATCHER_METRICS_HOST=127.0.0.1
# Optional keyless signing of ledger tree heads. No token means no bundle.
# DIPCATCHER_SIGSTORE_ID_TOKEN=
# DIPCATCHER_SIGSTORE_INSTANCE=production
