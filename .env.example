# Copy to .env. Never commit secrets.
QUANT_DATA_ROOT=data
MLFLOW_TRACKING_URI=./mlruns
# QUANT_VENDOR_API_KEY=
# Required for non-localhost API access (send as X-API-Key). Prefer binding 127.0.0.1.
# QUANT_API_KEY=

# fx-1 model lane
# Required for `fx1 eval --backend hosted_k3` / `make fx1-eval` (Moonshot API).
# MOONSHOT_API_KEY=
# Enables checkpoint signature enforcement when serving a local fx-1.
# FX1_SIGNING_KEY=
