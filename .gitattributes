# Preserve Git blob bytes for sealed receipts on every platform.
# The LFS rules below keep binary arrays outside text conversion.
* text=auto eol=lf
data/file_us_wide/**/*.parquet filter=lfs diff=lfs merge=lfs -text
data/file_us_wide/**/*.npy filter=lfs diff=lfs merge=lfs -text
RESEARCH_REFERENCES.md merge=union
MATH_SPEC.md merge=union
docs/ULTRAPLAN_FRONTIER.md merge=union
day_grind_progress.md merge=union

# docs/architecture/* and docs/evidence/* are regenerated artifacts (see
# scripts/gen_arch_diagrams.py and scripts/build_evidence_report.py). On a
# merge conflict, take either side and regenerate — the `diagrams` CI job and
# the evidence-page check fail if the tree does not match generator output.

# Sealed 2026-09-25 Phase-1 receipt bytes are evidence. Keep JSON LF on every
# checkout, including Windows, and leave compressed receipts byte-for-byte.
data/metadata/cost_aware_tournament/us_wide_20260925/*.json text eol=lf
data/metadata/cost_aware_tournament/us_wide_20260925/*.json.gz -text
data/metadata/net_tournament/us_wide_20260925/*.json text eol=lf
data/metadata/net_tournament/us_wide_20260925/*.json.gz -text
data/metadata/research/phase1_evidence_index.json text eol=lf
